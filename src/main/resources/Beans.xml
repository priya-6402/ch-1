<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="addrBean" class="com.lab.Address">
        <property name="city" value="Pune"/>
        <property name="state" value="Maharashtra"/>
        <property name="pinCode" value="412105"/>
    </bean>

    <bean id="studentBean" class="com.lab.Student">
        <property name="rollNo" value="11"/>
        <property name="name" value="Aniket Tayade"/>
        <property name="address" ref="addrBean"/>
    </bean>
</beans>
